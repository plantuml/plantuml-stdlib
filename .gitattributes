# Sprite pixel data produced by `plantuml -encodesprite` (see CONTRIBUTING.md,
# "Automating conversion from ready images"). These files contain nothing but
# the generated sprite block - no hand-written PlantUML - so collapsing their
# diffs in pull requests loses nothing.
stdlib/**/*-sprite.puml linguist-generated=true
stdlib/**/*_LARGE*.puml linguist-generated=true

# Build-time checksums written by MainSpm (src/main/java/.../spm/MainSpm.java).
# Fully machine-generated, never hand-edited.
output/**/*.sha1 linguist-generated=true
