

' Styling
' ##################################

hide stereotype

!definelong EntityColoring(e_stereo)
skinparam rectangle<<e_stereo>> {
    BackgroundColor GCP_BG_COLOR
    BorderColor transparent
    Shadowing false
}
!enddefinelong

' Overwriting Elements
' ##################################
!function $GCPImg($service, $color="#036ffc")
!if %function_exists("$" + $service + "IMG")
!return %call_user_func("$" + $service + "IMG")
!endif
!return "<color:" + $color + "><$" + $service + "></color>"
!endfunction

!definelong Entity(e_alias, e_label, e_techn, e_color, e_sprite, e_stereo)
rectangle "$GCPImg(e_sprite, e_color)\n\n==e_label" <<e_stereo>> as e_alias
!enddefinelong

!definelong Entity(e_alias, e_label, e_techn, e_descr, e_color, e_sprite, e_stereo)
rectangle "$GCPImg(e_sprite, e_color)\n\n==e_label" <<e_stereo>> as e_alias
!enddefinelong